<Window x:Class="LocalizationTranslationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalizationTranslationWPF"
        mc:Ignorable="d"
        Title="本地化工具 - LYQ" Topmost="True" MinWidth="600" MinHeight="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="tabControl" SelectionChanged="tabControl_SelectionChanged" Grid.ColumnSpan="2" Margin="10,10,10,220">
            <TabItem Header="翻译工具">
                <Grid Background="White" VerticalAlignment="Top">
                    <Button x:Name="btnStart" Content="开始" Margin="0,18,39,0" VerticalAlignment="Top" Width="166" Height="23" Click="btnStart_Click" HorizontalAlignment="Right"/>
                    <ComboBox x:Name="webDriveComboBox" HorizontalAlignment="Left" Margin="108,18,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="webDriveComboBox_SelectionChanged"/>
                    <ComboBox x:Name="dictConverterComboBox" HorizontalAlignment="Left" Margin="108,48,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="dictConverterComboBox_SelectionChanged" DisplayMemberPath="Name"/>
                    <Label x:Name="label" Content="浏览器工具" HorizontalAlignment="Left" Margin="27,16,0,0" VerticalAlignment="Top" AutomationProperties.HelpText=""/>
                    <Label x:Name="label1" Content="Json格式" HorizontalAlignment="Left" Margin="38,46,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="isoPairComboBox" HorizontalAlignment="Left" Margin="108,80,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="isoPairComboBox_SelectionChanged" DisplayMemberPath="Key"/>
                    <Label x:Name="label2" Content="文件名-ISO" HorizontalAlignment="Left" Margin="26,76,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="sourceLangComboBox" HorizontalAlignment="Left" Margin="108,110,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="sourceLangComboBox_SelectionChanged" DisplayMemberPath="Name"/>
                    <Label x:Name="label3" Content="翻译源语言" HorizontalAlignment="Left" Margin="27,106,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="targetLangComboBox" HorizontalAlignment="Left" Margin="108,140,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="targetLangComboBox_SelectionChanged" DisplayMemberPath="Name"/>
                    <Label x:Name="label4" Content="目标语言" HorizontalAlignment="Left" Margin="39,136,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="btnOpenInput" Content="语言源文件夹" HorizontalAlignment="Right" Margin="0,106,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenInput_Click"/>
                    <Button x:Name="btnOpenOutput" Content="输出文件夹" HorizontalAlignment="Right" Margin="0,136,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenOutput_Click"/>
                    <Button x:Name="btnOpenISO" Content="语言ISO文件夹" HorizontalAlignment="Right" Margin="0,76,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenISO_Click"/>
                    <Button x:Name="btnDictConverter" Content="格式配置文件夹" HorizontalAlignment="Right" Margin="0,46,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnDictConverter_Click"/>
                    <Button x:Name="btnOpenDriversFolder" Content="驱动文件夹" HorizontalAlignment="Right" Margin="0,166,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenDriversFolder_Click"/>
                    <Button x:Name="btnSimplified2Traditional" Content="简=&gt;繁" HorizontalAlignment="Left" Margin="108,196,0,0" VerticalAlignment="Top" Width="164" Height="25" Click="btnSimplified2Traditional_Click"/>
                    <Button x:Name="btnCombine" Content="合并" HorizontalAlignment="Left" Margin="108,226,0,0" VerticalAlignment="Top" Width="164" Height="25" Click="btnCombine_Click"/>
                    <Button x:Name="btnOpenCombineSourceFolder" Content="合并源文件夹" HorizontalAlignment="Right" Margin="0,196,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenCombineSourceFolder_Click"/>
                    <Button x:Name="btnOpenCombineOutputFolder" Content="合并输出文件夹" HorizontalAlignment="Right" Margin="0,226,39,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenCombineOutputFolder_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="编辑" Height="21" Margin="-2,-2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="40">
                <Grid Background="White">
                    <DataGrid x:Name="dataGrid" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,30,0,0" Background="White"/>
                    <ComboBox x:Name="comboBoxEditorTargetLanguage" HorizontalAlignment="Left" Margin="55,4,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="comboBoxEditorTargetLanguage_SelectionChanged"/>
                    <Label x:Name="labelEditorTargetLanguage" Content="语言" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="btnEditorSave" Content="保存" HorizontalAlignment="Left" Margin="180,6,0,0" VerticalAlignment="Top" Click="btnEditorSave_Click"/>
                    <Button x:Name="btnEditorDeleteKey" Content="删除选中Key(所有语言中)" HorizontalAlignment="Left" Margin="213,6,0,0" VerticalAlignment="Top" Click="btnEditorDeleteKey_Click"/>
                    <Button x:Name="btnOpenEditorFolder" Content="打开编辑器文件夹" HorizontalAlignment="Left" Margin="359,6,0,0" VerticalAlignment="Top" Click="btnOpenEditorFolder_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        <RichTextBox x:Name="logBox" Background="Black" IsReadOnly="True" IsUndoEnabled="False" VerticalAlignment="Bottom" Height="200" MinWidth="0" Margin="10,10,10,10"/>
    </Grid>
</Window>
