<Window x:Class="LocalizationTranslationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="本地化工具 - LYQ" MinWidth="800" MinHeight="540" Width="800" Height="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 主功能区 -->
            <RowDefinition Height="*"/>
            <!-- 日志输出区 -->
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        
        <!-- TabControl 主区域，包含各个功能页 -->
        <TabControl x:Name="TabControl" SelectionChanged="TabControlSelectionChanged" Grid.Row="0">
            <!-- 翻译页 -->
            <TabItem Header="翻译">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 开始按钮行 -->
                        <RowDefinition Height="Auto"/>  <!-- 翻译源语言行 -->
                        <RowDefinition Height="Auto"/>  <!-- 目标语言行 -->
                        <RowDefinition Height="Auto"/>  <!-- 翻译方式行 -->
                        <RowDefinition Height="Auto"/>  <!-- 文件夹选择行 -->
                        <RowDefinition Height="Auto"/>  <!-- 其他操作行 -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 第一行：右上角“开始”按钮 -->
                    <Button x:Name="BtnStart" Content="开始" Width="100" Height="30" 
                            Grid.Column="2" Grid.Row="0" Margin="5" Click="BtnStartClick"/>
                    
                    <!-- 第二行：翻译源语言 -->
                    <Label Content="翻译源语言：" Grid.Column="0" Grid.Row="0" 
                           VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="SourceLangComboBox" Grid.Column="1" Grid.Row="0" 
                              Height="25" Margin="5" SelectionChanged="SourceLangComboBoxSelectionChanged"
                              DisplayMemberPath="Name"/>
                    
                    <!-- 第三行：目标语言 -->
                    <Label Content="目标语言：" Grid.Column="0" Grid.Row="1" 
                           VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="TargetLangComboBox" Grid.Column="1" Grid.Row="1" 
                              Height="25" Margin="5" SelectionChanged="TargetLangComboBoxSelectionChanged"
                              DisplayMemberPath="Name"/>
                    
                    <!-- 第四行：翻译方式 -->
                    <Label Content="翻译方式：" Grid.Column="0" Grid.Row="2" 
                           VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="TranslateMethodComboBox" Grid.Column="1" Grid.Row="2" 
                              Height="25" Margin="5" SelectionChanged="TranslateMethodComboBoxSelectionChanged"/>
                    
                    <!-- 第五行：文件夹选择 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4" 
                                Margin="5" HorizontalAlignment="Left">
                        <Button x:Name="BtnOpenInput" Content="语言源文件夹" Width="120" Height="25" 
                                Margin="0,0,5,0" Click="BtnOpenInputClick"/>
                        <Button x:Name="BtnOpenOutput" Content="输出文件夹" Width="120" Height="25" 
                                Margin="0,0,5,0" Click="BtnOpenOutputClick"/>
                        <Button x:Name="BtnOpenCombineSourceFolder" Content="合并源文件夹" Width="120" Height="25" 
                                Margin="0,0,5,0" Click="BtnOpenCombineSourceFolderClick"/>
                        <Button x:Name="BtnOpenCombineOutputFolder" Content="合并输出文件夹" Width="120" Height="25" 
                                Click="BtnOpenCombineOutputFolderClick"/>
                    </StackPanel>
                    
                    <!-- 第六行：其他操作按钮 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5" 
                                Margin="5" HorizontalAlignment="Left">
                        <Button x:Name="BtnSimplified2Traditional" Content="简→繁" Width="100" Height="25" 
                                Margin="0,0,5,0" Click="BtnSimplified2TraditionalClick"/>
                        <Button x:Name="BtnCombine" Content="合并" Width="100" Height="25" 
                                Margin="0,0,5,0" Click="BtnCombineClick"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- 编辑页 -->
            <TabItem Header="编辑">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 控件行 -->
                        <RowDefinition Height="*"/>     <!-- DataGrid 行 -->
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Label Content="语言：" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="ComboBoxEditorTargetLanguage" Width="120" Height="25" 
                                  Margin="5" SelectionChanged="ComboBoxEditorTargetLanguageSelectionChanged"/>
                        <Button x:Name="BtnEditorSave" Content="保存" Width="80" Height="25" 
                                Margin="5" Click="BtnEditorSaveClick"/>
                        <Button x:Name="BtnEditorDeleteKey" Content="删除选中Key(所有语言中)" Width="180" Height="25" 
                                Margin="5" Click="BtnEditorDeleteKeyClick"/>
                        <Button x:Name="BtnOpenEditorFolder" Content="打开编辑器文件夹" Width="140" Height="25" 
                                Margin="5" Click="BtnOpenEditorFolderClick"/>
                    </StackPanel>
                    <DataGrid x:Name="DataGridEditor" Grid.Row="1" Margin="5" 
                              AutoGenerateColumns="True" 
                              IsTextSearchCaseSensitive="True" 
                              CanUserDeleteRows="False" CanUserAddRows="False"/>
                </Grid>
            </TabItem>
            
            <!-- 新增页 -->
            <TabItem Header="新增">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 按钮行 -->
                        <RowDefinition Height="*"/>     <!-- DataGrid 行 -->
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="BtnOpenAddNewFolder" Content="打开新增文件夹" Width="120" Height="25" 
                                Margin="5" Click="BtnOpenAddNewFolderClick"/>
                        <Button x:Name="BtnAddNewLoad" Content="加载" Width="80" Height="25" 
                                Margin="5" Click="BtnAddNewLoadClick"/>
                        <Button x:Name="BtnAddNewSave" Content="保存" Width="80" Height="25" 
                                Margin="5" Click="BtnAddNewSaveClick"/>
                        <Button x:Name="BtnPasteRow" Content="粘贴行" Width="80" Height="25" 
                                Margin="5" Click="BtnPasteRowClick"/>
                    </StackPanel>
                    <DataGrid x:Name="DataGridAddNew" Grid.Row="1" Margin="5" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>
            
            <!-- 设置页 -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 浏览器工具 -->
                        <Label Content="浏览器工具：" Grid.Row="0" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="WebDriveComboBox" Grid.Row="0" Grid.Column="1" Height="25" 
                                  Margin="5" SelectionChanged="WebDriveComboBoxSelectionChanged"/>
                        <Button x:Name="BtnOpenDriversFolder" Content="驱动文件夹" Grid.Row="0" Grid.Column="2" 
                                Width="120" Height="25" Margin="5" Click="BtnOpenDriversFolderClick"/>
                        
                        <!-- Json格式 -->
                        <Label Content="Json格式：" Grid.Row="1" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="DictConverterComboBox" Grid.Row="1" Grid.Column="1" Height="25" 
                                  Margin="5" SelectionChanged="DictConverterComboBoxSelectionChanged"
                                  DisplayMemberPath="Name"/>
                        <Button x:Name="BtnDictConverter" Content="格式配置文件夹" Grid.Row="1" Grid.Column="2" 
                                Width="120" Height="25" Margin="5" Click="BtnDictConverterClick"/>
                        
                        <!-- 文件名-ISO -->
                        <Label Content="文件名-ISO：" Grid.Row="2" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="IsoPairComboBox" Grid.Row="2" Grid.Column="1" Height="25" 
                                  Margin="5" SelectionChanged="IsoPairComboBoxSelectionChanged"
                                  DisplayMemberPath="Key"/>
                        <Button x:Name="BtnOpenIso" Content="语言ISO文件夹" Grid.Row="2" Grid.Column="2" 
                                Width="120" Height="25" Margin="5" Click="BtnOpenIsoClick"/>
                        
                        <!-- API Endpoint -->
                        <Label Content="API Endpoint(AIApi)：" Grid.Row="3" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="TextBoxApiEndpoint" Grid.Row="3" Grid.Column="1" Height="25" VerticalContentAlignment="Center"
                                 Margin="5" TextWrapping="Wrap" TextChanged="TextBoxApiEndpointTextChanged" 
                                 Grid.ColumnSpan="2"/>
                        
                        <!-- API Key -->
                        <Label Content="API Key(AIApi)：" Grid.Row="4" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="TextBoxApiKey" Grid.Row="4" Grid.Column="1" Height="25" VerticalContentAlignment="Center"
                                 Margin="5" TextWrapping="Wrap" TextChanged="TextBoxApiKeyTextChanged" 
                                 Grid.ColumnSpan="2"/>
                        
                        <!-- Model -->
                        <Label Content="Model(AIApi)：" Grid.Row="5" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="TextBoxModel" Grid.Row="5" Grid.Column="1" Height="25" VerticalContentAlignment="Center"
                                 Margin="5" TextWrapping="Wrap" TextChanged="TextBoxModelTextChanged" 
                                 Grid.ColumnSpan="2"/>
                        
                        <!-- Prompt -->
                        <Label Content="Prompt(AIApi/DS)：" Grid.Row="6" Grid.Column="0" 
                               VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="TextBoxPrompt" Grid.Row="6" Grid.Column="1" Height="25" VerticalContentAlignment="Center"
                                 Margin="5" TextWrapping="Wrap" TextChanged="TextBoxPromptTextChanged" 
                                 Grid.ColumnSpan="2"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- 日志输出区域 -->
        <RichTextBox x:Name="LogBox" Grid.Row="1" Background="Black" Foreground="White" 
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
    </Grid>
</Window>
