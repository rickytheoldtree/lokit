<ui:FluentWindow x:Class="LocalizationTranslationWPF.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:LocalizationTranslationWPF"
                 xmlns:pages="clr-namespace:LocalizationTranslationWPF.Navigation"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="本地化工具"
                 MinWidth="900" MinHeight="640" Width="1180" Height="800"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Closing="MainWindowClosing"
                 SizeChanged="MainWindowSizeChanged"
                 AllowDrop="True" PreviewDragOver="ProjectFilesDragOver" PreviewDrop="ProjectFilesDrop"
                 PreviewKeyDown="MainWindowPreviewKeyDown">
    <local:PageStore.Pages>
        <x:Array Type="{x:Type UserControl}">
        <pages:TranslationPage x:Name="TranslationPage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20,20,20,24" MaxWidth="960" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="TranslationPageTitleTextBlock" Text="翻译" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="新增、翻译、合并别人改过的 JSON，持续维护同一个项目。"
                                   Style="{StaticResource PageDescriptionStyle}" />

                        <ui:Card x:Name="ProjectWelcomeCard" Margin="0,20,0,0" Padding="28">
                            <StackPanel>
                                <TextBlock Text="从一个项目开始" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="首次使用时新建项目，选择游戏的语言目录；之后新增、翻译和编辑都在项目中完成，检查后统一导出。"
                                           TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.68" />
                                <TextBlock Text="导出的 JSON 被别人直接改过，也不用重新建项目：打开项目后把文件拖进来，预览差异并合并。"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.68" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="TranslationConfigurationCard" Margin="0,20,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="翻译配置" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="选择源语言、目标语言和翻译服务。"
                                           Style="{StaticResource PageDescriptionStyle}" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="源语言" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="SourceLangComboBox"
                                                  Style="{StaticResource StandardComboBoxStyle}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="SourceLangComboBoxSelectionChanged" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                   Margin="0,0,0,7" Opacity="0.7" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="目标语言" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TargetLangComboBox"
                                                  Style="{StaticResource StandardComboBoxStyle}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="TargetLangComboBoxSelectionChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="目标数量" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TargetLangAmountComboBox"
                                                  Style="{StaticResource StandardComboBoxStyle}"
                                                  SelectionChanged="TargetLangAmountComboBoxSelectionChanged" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="翻译方式" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TranslateMethodComboBox"
                                                  Style="{StaticResource StandardComboBoxStyle}"
                                                  SelectionChanged="TranslateMethodComboBoxSelectionChanged" />
                                    </StackPanel>
                                    <ui:Button x:Name="BtnStart"
                                               Grid.Column="2"
                                               Height="38"
                                               VerticalAlignment="Bottom"
                                               Content="开始翻译"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Play24}"
                                               Click="BtnStartClick" />
                                </Grid>
                                <TextBlock x:Name="ManualTranslationHint" Visibility="Collapsed"
                                           Text="复制程序生成的提示词到任意 AI，再将完整回复粘贴回来。无需 API Key 或浏览器驱动；使用设置页中的 AI 提示词。"
                                           Style="{StaticResource FieldHintStyle}" Margin="0,12,0,0" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="TranslationUtilitiesCard" Margin="0,16,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="翻译只处理新增、缺失、空译文以及手动标记的待重译条目；其他已有译文始终保留。"
                                           Style="{StaticResource FieldHintStyle}" Margin="0,0,0,14" />
                                <TextBlock x:Name="ProjectLocationTextBlock" TextWrapping="Wrap" Opacity="0.68" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </pages:TranslationPage>

        <pages:EditorPage x:Name="EditorPage">
            <Grid x:Name="EditorPageLayout" Margin="20,20,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="编辑语言内容" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Grid.Row="1" Text="查看并修改已有的本地化键值。"
                           Style="{StaticResource PageDescriptionStyle}" />

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="语言" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Margin="0,0,10,0" />
                                    <ComboBox x:Name="ComboBoxEditorTargetLanguage"
                                              Width="150"
                                              Style="{StaticResource StandardComboBoxStyle}"
                                              SelectionChanged="ComboBoxEditorTargetLanguageSelectionChanged" />
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right" Margin="18,0,0,0">
                                    <ui:Button x:Name="BtnEditorSave" Content="保存"
                                               Margin="0,0,8,0" Padding="12,7"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon Save24}"
                                               Click="BtnEditorSaveClick" />
                                    <ui:Button x:Name="BtnEditorUndo" Content="撤销更改"
                                               Margin="0,0,8,0" Padding="12,7"
                                               ToolTip="撤销全部未保存更改，恢复到最近一次保存或加载的内容"
                                               Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                               Click="BtnEditorUndoClick" />
                                    <ui:Button x:Name="BtnEditorRetranslate" Content="标记重译"
                                               Margin="0,0,8,0" Padding="12,7"
                                               ToolTip="让选中的旧 Key 在下次翻译时重新生成；现有译文会保留到新结果成功应用"
                                               Icon="{ui:SymbolIcon Translate24}"
                                               Click="BtnEditorRetranslateClick" />
                                    <ui:Button x:Name="BtnEditorDeleteKey" Content="删除选中 Key"
                                               Padding="12,7"
                                               Appearance="Danger"
                                               Icon="{ui:SymbolIcon Delete24}"
                                               ToolTip="从项目的所有语言中删除选中的 Key，发布时才修改正式文件"
                                               Click="BtnEditorDeleteKeyClick" />
                                </WrapPanel>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="EditorEmptyValueTextBlock"
                                               Foreground="#F59E0B" Margin="0,0,14,0"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="EditorDirtyTextBlock" Text="未保存"
                                               Foreground="#F59E0B" FontWeight="SemiBold"
                                               Margin="0,0,14,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="EditorRetranslateTextBlock"
                                               Foreground="#F59E0B" FontWeight="SemiBold"
                                               Margin="0,0,14,0" Visibility="Collapsed"
                                               ToolTip="按 Key × 目标语言计数；成功翻译对应语言后自动清除" />
                                    <TextBlock x:Name="EditorRowCountTextBlock" Opacity="0.68" />
                                </StackPanel>
                                <ui:TextBox x:Name="EditorSearchTextBox" Width="280"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource StandardTextBoxStyle}"
                                            PlaceholderText="搜索 Key 或文本"
                                            TextChanged="EditorSearchTextChanged" />
                            </DockPanel>
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Row="2">
                        <ui:DataGrid x:Name="DataGridEditor"
                                     Style="{StaticResource LocalizationDataGridStyle}"
                                     AutoGenerateColumns="True"
                                     IsTextSearchCaseSensitive="True"
                                     CanUserDeleteRows="False"
                                     CanUserAddRows="False"
                                     FrozenColumnCount="1"
                                     AutoGeneratingColumn="DataGridEditorAutoGeneratingColumn"
                                     CellEditEnding="EditingDataGridEditEnding"
                                     RowEditEnding="EditingDataGridEditEnding"
                                     SelectionChanged="EditingDataGridSelectionChanged" />
                        <Border x:Name="EditorEmptyStateBorder"
                                Background="{DynamicResource ApplicationBackgroundBrush}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="360">
                                <TextBlock x:Name="EditorEmptyStateTitle"
                                           Text="尚未加载语言文件"
                                           Style="{StaticResource SectionTitleStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EditorEmptyStateDescription"
                                           Text="选择语言后会在这里显示本地化键值。"
                                           Style="{StaticResource PageDescriptionStyle}"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </pages:EditorPage>

        <pages:AddNewPage x:Name="AddNewPage">
            <Grid x:Name="AddNewPageLayout" Margin="20,20,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="新增本地化内容" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="AddNewPageDescription" Grid.Row="1" Text="添加源语言文案，保存到项目后可直接翻译。"
                           Style="{StaticResource PageDescriptionStyle}" />

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Card Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <ui:Button x:Name="BtnAddNewRow" Content="新增行"
                                           Margin="0,0,8,0" Padding="12,7"
                                           Icon="{ui:SymbolIcon Add24}"
                                           Click="BtnAddNewRowClick" />
                                <ui:Button x:Name="BtnPasteRow" Content="粘贴行"
                                           Margin="0,0,8,0" Padding="12,7"
                                           Icon="{ui:SymbolIcon ClipboardPaste24}"
                                           Click="BtnPasteRowClick" />
                                <ui:Button x:Name="BtnAddNewDeleteRow" Content="移除选中行"
                                           Margin="0,0,8,0" Padding="12,7"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Click="BtnAddNewDeleteRowClick" />
                                <ui:Button x:Name="BtnAddNewUndo" Content="撤销更改"
                                           Margin="0,0,8,0" Padding="12,7"
                                           ToolTip="撤销全部未保存更改，恢复到最近一次保存或加载的内容"
                                           Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                           Click="BtnAddNewUndoClick" />
                                <ui:Button x:Name="BtnAddNewSave" Content="加入项目"
                                           Padding="12,7"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Click="BtnAddNewSaveClick" />
                            </WrapPanel>
                            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AddNewValidationTextBlock"
                                               Foreground="#E05252" FontWeight="SemiBold"
                                               ToolTip="Key 不能为空或重复；将鼠标停在标红的行上可查看原因。"
                                               Margin="0,0,14,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="AddNewDirtyTextBlock" Text="未保存"
                                               Foreground="#F59E0B" FontWeight="SemiBold"
                                               Margin="0,0,14,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="AddNewRowCountTextBlock" Opacity="0.68" />
                                </StackPanel>
                                <ui:TextBox x:Name="AddNewSearchTextBox" Width="280"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource StandardTextBoxStyle}"
                                            PlaceholderText="搜索 Key 或文本"
                                            TextChanged="AddNewSearchTextChanged" />
                            </DockPanel>
                        </Grid>
                    </ui:Card>

                    <Grid Grid.Row="2">
                        <ui:DataGrid x:Name="DataGridAddNew"
                                     Style="{StaticResource LocalizationDataGridStyle}"
                                     RowStyle="{StaticResource ValidatedDataGridRowStyle}"
                                     AutoGenerateColumns="True"
                                     CanUserDeleteRows="False"
                                     CanUserAddRows="False"
                                     FrozenColumnCount="1"
                                     AutoGeneratingColumn="DataGridAddNewAutoGeneratingColumn"
                                     CellEditEnding="EditingDataGridEditEnding"
                                     RowEditEnding="EditingDataGridEditEnding"
                                     SelectionChanged="EditingDataGridSelectionChanged" />
                        <Border x:Name="AddNewEmptyStateBorder"
                                Background="{DynamicResource ApplicationBackgroundBrush}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="380">
                                <TextBlock x:Name="AddNewEmptyStateTitle"
                                           Text="还没有待新增内容"
                                           Style="{StaticResource SectionTitleStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="AddNewEmptyStateDescription"
                                           Text="可以新增空行，或粘贴以 Tab 分隔的 Key 和文本。"
                                           Style="{StaticResource PageDescriptionStyle}"
                                           Margin="0,8,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </pages:AddNewPage>

        <pages:SettingsPage x:Name="SettingsPage">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20,20,20,24" MaxWidth="960" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="配置文件格式、翻译服务和网络连接。"
                                   Style="{StaticResource PageDescriptionStyle}" />

                        <ui:Card Margin="0,20,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="浏览器、JSON 格式和语言文件命名规则。"
                                           Style="{StaticResource PageDescriptionStyle}" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="应用外观"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ComboBox x:Name="ThemeModeComboBox"
                                              Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                              Style="{StaticResource StandardComboBoxStyle}"
                                              SelectionChanged="ThemeModeComboBoxSelectionChanged" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="浏览器"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ComboBox x:Name="WebDriveComboBox"
                                              Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                              Style="{StaticResource StandardComboBoxStyle}"
                                              SelectionChanged="WebDriveComboBoxSelectionChanged" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="JSON 格式"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ComboBox x:Name="DictConverterComboBox"
                                              Grid.Row="4" Grid.Column="1"
                                              Style="{StaticResource StandardComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="DictConverterComboBoxSelectionChanged" />
                                    <ui:Button x:Name="BtnDictConverter"
                                               Grid.Row="4" Grid.Column="3"
                                               Content="配置文件夹"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Click="BtnDictConverterClick" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="文件名与 ISO"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ComboBox x:Name="IsoPairComboBox"
                                              Grid.Row="6" Grid.Column="1"
                                              Style="{StaticResource StandardComboBoxStyle}"
                                              DisplayMemberPath="Key"
                                              SelectionChanged="IsoPairComboBoxSelectionChanged" />
                                    <ui:Button x:Name="BtnOpenIso"
                                               Grid.Row="6" Grid.Column="3"
                                               Content="ISO 文件夹"
                                               Icon="{ui:SymbolIcon FolderGlobe20}"
                                               Click="BtnOpenIsoClick" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,16,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="AI 翻译" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="API 模式需配置服务地址、密钥和模型。提示词供 API、DeepSeek 网页和手动 AI 翻译共用。"
                                           Style="{StaticResource PageDescriptionStyle}" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="API Endpoint"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ui:TextBox x:Name="TextBoxApiEndpoint"
                                                Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                Style="{StaticResource StandardTextBoxStyle}"
                                                PlaceholderText="https://api.example.com/chat/completions"
                                                TextChanged="TextBoxApiEndpointTextChanged" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ui:PasswordBox x:Name="PasswordBoxApiKey"
                                                    Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                                    Style="{StaticResource StandardPasswordBoxStyle}"
                                                    PlaceholderText="输入 API Key"
                                                    ToolTip="使用输入框右侧按钮显示或隐藏 API Key"
                                                    AutomationProperties.Name="API Key"
                                                    PasswordChanged="PasswordBoxApiKeyPasswordChanged" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="模型"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ui:TextBox x:Name="TextBoxModel"
                                                Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                                Style="{StaticResource StandardTextBoxStyle}"
                                                PlaceholderText="例如 deepseek-chat"
                                                TextChanged="TextBoxModelTextChanged" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="提示词"
                                               VerticalAlignment="Top" Margin="0,9,0,0" FontWeight="SemiBold" />
                                    <ui:TextBox x:Name="TextBoxPrompt"
                                                Grid.Row="6" Grid.Column="1"
                                                Style="{StaticResource MultilineTextBoxStyle}"
                                                PlaceholderText="输入提示词，{0} 为目标语言，{1} 为待翻译内容"
                                                TextChanged="TextBoxPromptTextChanged" />
                                    <ui:Button x:Name="BtnResetPrompt"
                                               Grid.Row="6" Grid.Column="3"
                                               VerticalAlignment="Top"
                                               Height="36"
                                               Content="重置"
                                               Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                               Click="ResetPromptClick" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,16,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="网络" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="仅在自动下载浏览器驱动失败时配置代理。"
                                           Style="{StaticResource PageDescriptionStyle}" />
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="驱动代理（可选）"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBox x:Name="TextBoxDriverProxy"
                                                    Style="{StaticResource StandardTextBoxStyle}"
                                                    PlaceholderText="http://127.0.0.1:7890"
                                                    TextChanged="TextBoxDriverProxyTextChanged"
                                                    ToolTip="例如 http://127.0.0.1:7890" />
                                        <TextBlock Text="留空表示直连，例如：http://127.0.0.1:7890"
                                                   Style="{StaticResource FieldHintStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,16,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="更新与数据" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="从 GitHub 获取新版本；配置、ISO 和格式转换器保存在数据目录，更新时不会丢失。"
                                           Style="{StaticResource PageDescriptionStyle}" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText"
                                               Grid.Row="0" Grid.Column="1"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ui:Button x:Name="BtnUpdate"
                                               Grid.Row="0" Grid.Column="3"
                                               Content="检查更新"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Click="BtnUpdateClick" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="数据目录"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DataPathText"
                                               Grid.Row="2" Grid.Column="1"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:Button x:Name="BtnOpenData"
                                               Grid.Row="2" Grid.Column="3"
                                               Content="打开"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Click="BtnOpenDataClick" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="旧版本数据"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="选择旧版本程序旁的 data 文件夹，导入配置、ISO 和格式转换器，重启后生效。"
                                               VerticalAlignment="Center" Margin="0"
                                               Style="{StaticResource FieldHintStyle}" />
                                    <ui:Button x:Name="BtnImportData"
                                               Grid.Row="4" Grid.Column="3"
                                               Content="导入…"
                                               Icon="{ui:SymbolIcon ArrowImport24}"
                                               Click="BtnImportDataClick" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </pages:SettingsPage>
        </x:Array>
    </local:PageStore.Pages>
    <ui:FluentWindow.Content>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="LogRow" Height="0" MinHeight="0" MaxHeight="360" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Title="" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Translate24" FontSize="16"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="0,0,36,0" VerticalAlignment="Center">
                    <TextBlock Text="本地化工具" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Ellipse x:Name="TitleBarDirtyIndicator"
                             Width="6" Height="6" Margin="8,0,0,0"
                             Fill="#F59E0B" VerticalAlignment="Center"
                             Visibility="Hidden" ToolTip="存在未保存的更改" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigationView" Grid.Row="1"
                           PaneDisplayMode="Left" IsPaneOpen="True"
                           OpenPaneLength="180" CompactPaneLength="48"
                           IsPaneToggleVisible="True" IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False" IsFooterSeparatorVisible="False"
                           FrameMargin="0" Transition="FadeInWithSlide"
                           Navigating="NavigationNavigating"
                           SelectionChanged="NavigationSelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavigationTranslate" Content="翻译"
                                       Icon="{ui:SymbolIcon Translate24}" TargetPageTag="translate"
                                       TargetPageType="{x:Type pages:TranslationPage}"
                                       AutomationProperties.Name="翻译页面" />
                <ui:NavigationViewItem x:Name="NavigationEditor" Content="编辑"
                                       Icon="{ui:SymbolIcon TableEdit24}" TargetPageTag="editor"
                                       TargetPageType="{x:Type pages:EditorPage}"
                                       AutomationProperties.Name="编辑页面" />
                <ui:NavigationViewItem x:Name="NavigationAddNew" Content="新增"
                                       Icon="{ui:SymbolIcon DocumentAdd24}" TargetPageTag="add"
                                       TargetPageType="{x:Type pages:AddNewPage}"
                                       AutomationProperties.Name="新增页面" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavigationSettings" Content="设置"
                                       Icon="{ui:SymbolIcon Settings24}" TargetPageTag="settings"
                                       TargetPageType="{x:Type pages:SettingsPage}"
                                       AutomationProperties.Name="设置页面" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.Header>
                <Border x:Name="ProjectToolbar" Margin="20,20,20,0" Padding="12,8"
                        CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnCreateProject" Content="新建项目" Margin="0,0,8,0" Click="BtnNewProjectClick" />
                            <ui:Button x:Name="BtnOpenProject" Content="打开项目" Margin="0,0,8,0" Click="BtnOpenProjectClick" />
                            <ui:Button x:Name="BtnReceiveChanges" Content="导入 JSON 修改" Appearance="Primary" Margin="0,0,8,0" Click="BtnReceiveChangesClick" />
                            <ui:Button x:Name="BtnContinueMerge" Content="继续合并" Margin="0,0,8,0" Click="BtnContinueMergeClick" />
                            <ui:Button x:Name="BtnPublishProject" Content="导出游戏资源"
                                       Margin="0,0,8,0" Icon="{ui:SymbolIcon FolderArrowRight24}" Click="BtnPublishProjectClick" />
                            <ui:Button x:Name="BtnProjectActions" Content="项目" Click="BtnProjectActionsClick">
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="新建项目" Click="BtnNewProjectClick" />
                                        <MenuItem Header="打开其他项目" Click="BtnOpenProjectClick" />
                                        <Separator />
                                        <MenuItem Header="从语言目录接收修改" Click="BtnImportFolderClick" />
                                        <MenuItem Header="撤销上次合并" Click="BtnUndoMergeClick" />
                                        <MenuItem Header="放弃保存的合并进度" Click="BtnDiscardMergeClick" />
                                        <MenuItem Header="高级操作">
                                            <MenuItem Header="同步游戏资源中的外部修改" Click="BtnSyncResourcesClick" />
                                            <MenuItem Header="打开项目所在目录" Click="BtnOpenProjectFolderClick" />
                                            <MenuItem Header="打开游戏资源目录" Click="BtnOpenTargetFolderClick" />
                                            <MenuItem Header="恢复上次发布" Click="BtnRestorePublishClick" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="关闭项目" Click="BtnCloseProjectClick" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProjectNameTextBlock" Text="未打开项目" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ProjectSummaryTextBlock" Text="新建项目或打开 .locproj 文件" FontSize="12" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ProjectDropHint" Text="拖入 .locproj 项目文件直接打开" FontSize="12" Opacity="0.62" Margin="0,8,0,2" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid Margin="24,8,24,0" VerticalAlignment="Top">
                    <Border x:Name="MainInfoBarSurface"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=MainInfoBar}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:InfoBar x:Name="MainInfoBar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsOpen="False" IsClosable="True" />
                    </Border>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>


        <Border Grid.Row="4" Margin="20,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ErrorsOnlyToggleButton"
                                  Style="{StaticResource StatusBarToggleButtonStyle}"
                                  Content="仅错误"
                                  Click="LogFilterChanged" />
                    <ToggleButton x:Name="AutoScrollToggleButton"
                                  Style="{StaticResource StatusBarToggleButtonStyle}"
                                  IsChecked="True"
                                  Content="自动滚动" />
                    <ui:Button x:Name="BtnCopyLog"
                               Style="{StaticResource StatusBarIconButtonStyle}"
                               ToolTip="复制当前日志"
                               Icon="{ui:SymbolIcon Copy24}"
                               Click="BtnCopyLogClick" />
                    <ui:Button x:Name="BtnClearLog"
                               Style="{StaticResource StatusBarIconButtonStyle}"
                               ToolTip="清空日志"
                               Icon="{ui:SymbolIcon DeleteDismiss24}"
                               Click="BtnClearLogClick" />
                    <ui:Button x:Name="BtnToggleLog"
                               Style="{StaticResource StatusBarTextButtonStyle}"
                               Content="展开日志"
                               Icon="{ui:SymbolIcon PanelBottomContract20}"
                               Click="BtnToggleLogClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#36A269" Margin="2,0,8,0" />
                    <TextBlock x:Name="StatusTextBlock" Text="就绪" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  运行日志" VerticalAlignment="Center" Opacity="0.62" />
                </StackPanel>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="LogSplitter"
                      Grid.Row="2"
                      Visibility="Collapsed"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <Border x:Name="LogPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Margin="20,0"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#353A44"
                Background="#17191F">
            <RichTextBox x:Name="LogBox"
                         Margin="2"
                         Padding="12,8"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#F3F4F6"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" />
        </Border>

        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="5"
                              Panel.ZIndex="200" />

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.RowSpan="5"
                              Panel.ZIndex="300" />
    </Grid>
    </ui:FluentWindow.Content>
</ui:FluentWindow>
