<Window x:Class="LocalizationTranslationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalizationTranslationWPF"
        mc:Ignorable="d"
        Title="本地化工具 - LYQ" MinWidth="600" MinHeight="480" Width="600" Height="480">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="tabControl" SelectionChanged="tabControl_SelectionChanged" Grid.ColumnSpan="2" Margin="10,10,10,220">
            <TabItem Header="翻译">
                <Grid Background="White" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55*"/>
                        <ColumnDefinition Width="130*"/>
                        <ColumnDefinition Width="102*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnStart" Content="开始" Margin="0,20,0,0" VerticalAlignment="Top" Width="166" Height="23" Click="btnStart_Click" HorizontalAlignment="Left" Grid.Column="2" UseLayoutRounding="False"/>
                    <ComboBox x:Name="sourceLangComboBox" HorizontalAlignment="Left" Margin="5,20,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="sourceLangComboBox_SelectionChanged" DisplayMemberPath="Name" Grid.Column="1" Height="21"/>
                    <Label x:Name="label3" Content="翻译源语言" HorizontalAlignment="Right" Margin="0,20,0,0" VerticalAlignment="Top" Height="25" Width="70"/>
                    <ComboBox x:Name="targetLangComboBox" HorizontalAlignment="Left" Margin="5,50,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="targetLangComboBox_SelectionChanged" DisplayMemberPath="Name" Grid.Column="1" Height="21"/>
                    <Label x:Name="label4" Content="目标语言" HorizontalAlignment="Right" Margin="0,50,0,0" VerticalAlignment="Top" Height="25" Width="58"/>
                    <Button x:Name="btnOpenInput" Content="语言源文件夹" HorizontalAlignment="Left" Margin="0,50,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenInput_Click" Grid.Column="2"/>
                    <Button x:Name="btnOpenOutput" Content="输出文件夹" HorizontalAlignment="Left" Margin="0,80,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenOutput_Click" Grid.Column="2"/>
                    <Button x:Name="btnSimplified2Traditional" Content="简=&gt;繁" HorizontalAlignment="Left" Margin="5,80,0,0" VerticalAlignment="Top" Width="164" Height="25" Click="btnSimplified2Traditional_Click" Grid.Column="1"/>
                    <Button x:Name="btnCombine" Content="合并" HorizontalAlignment="Left" Margin="5,110,0,0" VerticalAlignment="Top" Width="164" Height="25" Click="btnCombine_Click" Grid.Column="1"/>
                    <Button x:Name="btnOpenCombineSourceFolder" Content="合并源文件夹" HorizontalAlignment="Left" Margin="0,110,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenCombineSourceFolder_Click" Grid.Column="2"/>
                    <Button x:Name="btnOpenCombineOutputFolder" Content="合并输出文件夹" HorizontalAlignment="Left" Margin="0,140,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenCombineOutputFolder_Click" Grid.Column="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="编辑">
                <Grid Background="White">
                    <DataGrid x:Name="dataGridEditor" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,30,0,0" Background="White" IsTextSearchCaseSensitive="True" CanUserDeleteRows="False" CanUserAddRows="False"/>
                    <ComboBox x:Name="comboBoxEditorTargetLanguage" HorizontalAlignment="Left" Margin="55,4,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="comboBoxEditorTargetLanguage_SelectionChanged"/>
                    <Label x:Name="labelEditorTargetLanguage" Content="语言" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
                    <Button x:Name="btnEditorSave" Content="保存" HorizontalAlignment="Left" Margin="180,6,0,0" VerticalAlignment="Top" Click="btnEditorSave_Click"/>
                    <Button x:Name="btnEditorDeleteKey" Content="删除选中Key(所有语言中)" HorizontalAlignment="Left" Margin="213,6,0,0" VerticalAlignment="Top" Click="btnEditorDeleteKey_Click"/>
                    <Button x:Name="btnOpenEditorFolder" Content="打开编辑器文件夹" HorizontalAlignment="Left" Margin="359,6,0,0" VerticalAlignment="Top" Click="btnOpenEditorFolder_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="新增">
                <Grid>
                    <DataGrid x:Name="dataGridAddNew" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,30,0,0"/>
                    <Button x:Name="btnAddNewSave" Content="保存" HorizontalAlignment="Left" Margin="136,6,0,0" VerticalAlignment="Top" Click="btnAddNewSave_Click"/>
                    <Button x:Name="btnOpenAddNewFolder" Content="打开新增文件夹" HorizontalAlignment="Left" Margin="10,6,0,0" VerticalAlignment="Top" Click="btnOpenAddNewFolder_Click"/>
                    <Button x:Name="btnAddNewLoad" Content="加载" HorizontalAlignment="Left" Margin="103,6,0,0" VerticalAlignment="Top" Click="btnAddNewLoad_Click"/>
                    <Button x:Name="btnPasteRow" Content="粘贴行" HorizontalAlignment="Left" Margin="169,6,0,0" VerticalAlignment="Top" Click="btnPasteRow_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55*"/>
                        <ColumnDefinition Width="130*"/>
                        <ColumnDefinition Width="102*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="webDriveComboBox" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="webDriveComboBox_SelectionChanged" Grid.Column="1"/>
                    <ComboBox x:Name="dictConverterComboBox" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="dictConverterComboBox_SelectionChanged" DisplayMemberPath="Name" Grid.Column="1"/>
                    <Label x:Name="label" Content="浏览器工具" HorizontalAlignment="Right" Margin="0,20,0,0" VerticalAlignment="Top" AutomationProperties.HelpText=""/>
                    <Label x:Name="label1" Content="Json格式" HorizontalAlignment="Right" Margin="0,50,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="isoPairComboBox" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Width="166" SelectionChanged="isoPairComboBox_SelectionChanged" DisplayMemberPath="Key" Grid.Column="1"/>
                    <Label x:Name="label2" Content="文件名-ISO" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,0,0"/>
                    <Button x:Name="btnOpenISO" Content="语言ISO文件夹" HorizontalAlignment="Left" Margin="0,80,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenISO_Click" Grid.Column="2"/>
                    <Button x:Name="btnDictConverter" Content="格式配置文件夹" HorizontalAlignment="Left" Margin="0,50,0,0" VerticalAlignment="Top" Width="166" Height="25" Click="btnDictConverter_Click" Grid.Column="2"/>
                    <Button x:Name="btnOpenDriversFolder" Content="驱动文件夹" HorizontalAlignment="Left" VerticalAlignment="Top" Width="166" Height="25" Click="btnOpenDriversFolder_Click" Grid.Column="2" Margin="0,20,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
        <RichTextBox x:Name="logBox" Background="Black" IsReadOnly="True" IsUndoEnabled="False" VerticalAlignment="Bottom" Height="200" MinWidth="0" Margin="10,10,10,10"/>
    </Grid>
</Window>
