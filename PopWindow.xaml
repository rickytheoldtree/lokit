<Window x:Class="LocalizationTranslationWPF.PopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务进行中..." Height="200" Width="350" 
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True">
    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#FFCCCCCC" Background="White">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题提示文本 -->
            <TextBlock Name="TextBlock" Text="任务正在运行，请稍候..." FontSize="16" FontWeight="Bold" 
                       Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <!-- 进度条，可提示任务正在进行中 -->
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="20" Margin="0,0,0,10"/>
            <!-- 自定义按钮样式 -->
            <Button Grid.Row="2" x:Name="Btn" Content="取消任务" 
                    Width="100" Height="30" HorizontalAlignment="Center" 
                    Background="#FF007ACC" Foreground="White" BorderThickness="0" 
                    Cursor="Hand" Click="BtnCancelClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" Padding="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- 鼠标悬停时变色 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                            <!-- 鼠标按下时变色 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF003F73"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
