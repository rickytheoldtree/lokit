<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- 目标是 .NET 8；机器上只装了更高版本时允许向上滚动，避免"必须安装 .NET 8"直接起不来 -->
    <RollForward>Major</RollForward>
    <!-- 发布时由 release.bat 用 -p:Version 覆盖，Velopack 用它判断新旧 -->
    <Version>1.0.0</Version>
    <!-- 自定义入口，Velopack 需要在 WPF 启动前处理安装/更新钩子 -->
    <StartupObject>LocalizationTranslationWPF.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="lib\**" />
    <Compile Remove="IDictConverter\**" />
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="lib\**" />
    <EmbeddedResource Remove="IDictConverter\**" />
    <None Remove="lib\**" />
    <None Remove="IDictConverter\**" />
    <Page Remove="lib\**" />
    <Page Remove="IDictConverter\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\iso\CrossMath.txt" />
    <None Remove="data\iso\ElderMahjong.txt" />
    <None Remove="data\iso\GinRummy.txt" />
    <None Remove="data\iso\GoodsSort.txt" />
    <None Remove="data\iso\Mahjong.txt" />
    <None Remove="data\iso\TripeakFarm.txt" />
    <None Remove="data\iso\TripeaksDecor.txt" />
    <None Remove="data\iso\WaterSort.txt" />
    <None Remove="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Selenium.WebDriver" Version="4.48.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="data\converters\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="IDictConverter\IDictConverter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="data\iso\Example.txt" />
    <Content Include="data\iso\Example.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
