<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="lib\**" />
    <EmbeddedResource Remove="lib\**" />
    <None Remove="lib\**" />
    <Page Remove="lib\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="data\iso\CrossMath.txt" />
    <None Remove="data\iso\ElderMahjong.txt" />
    <None Remove="data\iso\GinRummy.txt" />
    <None Remove="data\iso\GoodsSort.txt" />
    <None Remove="data\iso\Mahjong.txt" />
    <None Remove="data\iso\TripeakFarm.txt" />
    <None Remove="data\iso\TripeaksDecor.txt" />
    <None Remove="data\iso\WaterSort.txt" />
    <None Remove="README.md" />
    <None Remove="web-drivers\chromedriver.exe" />
    <None Remove="web-drivers\geckodriver.exe" />
    <None Remove="web-drivers\msedgedriver.exe" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web-drivers\chromedriver.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="web-drivers\geckodriver.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="web-drivers\msedgedriver.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="converters\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IDictConverter\IDictConverter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="converters\TripeaksFarm.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="data\iso\Example.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
