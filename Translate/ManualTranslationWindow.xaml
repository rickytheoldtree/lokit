<ui:FluentWindow x:Class="Lokit.Translate.ManualTranslationWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="手动 AI 翻译 · Lokit"
                 Width="840" Height="760" MinWidth="640" MinHeight="640"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="手动 AI 翻译" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Lokit;component/Assets/lokit-small.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LanguageSummaryTextBlock" Style="{StaticResource SectionTitleStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="复制提示词到你使用的 AI，收到回复后粘贴到下方。全部目标语言会逐个处理。"
                       Style="{StaticResource PageDescriptionStyle}" TextWrapping="Wrap" />
            <DockPanel Grid.Row="2" Margin="0,16,0,8">
                <ui:Button x:Name="CopyPromptButton" DockPanel.Dock="Right" Content="复制提示词"
                           Icon="{ui:SymbolIcon Copy24}" Click="CopyPromptClick" />
                <TextBlock Text="1. 发送给 AI 的完整提示词" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ui:TextBox x:Name="PromptTextBox" Grid.Row="3"
                        Style="{StaticResource MultilineTextBoxStyle}" IsReadOnly="True"
                        MinHeight="80" FontFamily="Consolas" FontSize="13" />
            <DockPanel Grid.Row="4" Margin="0,16,0,8">
                <ui:Button x:Name="PasteResponseButton" DockPanel.Dock="Right" Content="粘贴回复"
                           Icon="{ui:SymbolIcon ClipboardPaste24}" Click="PasteResponseClick" />
                <TextBlock Text="2. AI 返回的完整内容" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <ui:TextBox x:Name="ResponseTextBox" Grid.Row="5"
                        Style="{StaticResource MultilineTextBoxStyle}"
                        PlaceholderText="在此粘贴或手动输入 AI 回复，可包含 Markdown 代码块。"
                        MinHeight="80" FontFamily="Consolas" FontSize="13"
                        TextChanged="ResponseTextChanged" />
            <ui:InfoBar x:Name="ResponseInfoBar" Grid.Row="6" Margin="0,12,0,0"
                        IsOpen="False" IsClosable="True" MaxHeight="110" />
            <Grid Grid.Row="7" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="校验通过后保存到项目工作副本。取消保留已完成的语言。"
                           TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.65"
                           FontSize="12" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="CancelTranslationButton" Content="取消任务" MinWidth="100"
                               Margin="0,0,10,0" Click="CancelTranslationClick" />
                    <ui:Button x:Name="SubmitResponseButton" Content="校验并保存" MinWidth="116"
                               Appearance="Primary" IsEnabled="False" Click="SubmitResponseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
